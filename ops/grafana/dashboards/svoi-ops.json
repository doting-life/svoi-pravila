{
  "uid": "svoi-ops",
  "title": "Эксплуатация",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "svoi-pravila",
    "ops",
    "prometheus"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "LLM: p50 и p95 длительности (сценарий × поверхность)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "svoi-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "svoi-metrics"
          },
          "expr": "histogram_quantile(0.50, sum by (le, scenario, surface) (rate(sp_llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{scenario}}/{{surface}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "svoi-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, scenario, surface) (rate(sp_llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{scenario}}/{{surface}}",
          "range": true
        }
      ]
    },
