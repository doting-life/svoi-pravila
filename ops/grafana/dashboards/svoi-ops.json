{
  "uid": "svoi-ops",
  "title": "Эксплуатация",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "svoi-pravila",
    "ops",
    "prometheus"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
