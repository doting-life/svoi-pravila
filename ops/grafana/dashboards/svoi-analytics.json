          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  day,\n  active_users AS dau,\n  new_users,\n  target_users_total,\n  appeals AS target_actions,\n  ROUND(appeals::numeric / NULLIF(active_users, 0), 2) AS target_actions_per_dau,\n  generations,\n  generation_errors,\n  ROUND(generation_errors::numeric / NULLIF(generations, 0), 2) AS error_rate,\n  users_limited,\n  llm_calls,\n  ROUND(llm_calls::numeric / NULLIF(active_users, 0), 2) AS llm_calls_per_active_user,\n  billable_tokens,\n  ROUND(llm_cost_rub, 2) AS llm_cost_rub,\n  ROUND(llm_cost_rub / NULLIF(appeals, 0), 2) AS llm_cost_per_target_action_rub\nFROM analytics_daily\nWHERE $__timeFilter(day)\nORDER BY day"
