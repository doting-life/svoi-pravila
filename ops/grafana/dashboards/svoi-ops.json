    {
      "id": 16,
      "type": "timeseries",
      "title": "Диск: свободно, % (по разделам)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "datasource": {
        "type": "prometheus",
        "uid": "svoi-metrics"
      },
