            "type": "grafana-postgresql-datasource",
            "uid": "svoi-analytics-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  cohort_day AS \"time\",\n  CASE\n    WHEN d1_retained IS NULL THEN NULL\n    ELSE 100.0 * d1_retained / NULLIF(size, 0)\n  END AS \"D1%\"\nFROM analytics_cohorts\nWHERE $__timeFilter(cohort_day)\nORDER BY cohort_day"
        }
      ]
