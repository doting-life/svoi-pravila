{
    "name": "svoi-pravila-miniapp",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@12.9.1",
    "engines": {
        "node": "24.21.0",
        "pnpm": "12.9.1"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "audit": "pnpm audit --prod --audit-level=high",
        "openapi:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
        "lint:storage-ban": "node scripts/assert-storage-ban.mjs",
        "screenshots": "node scripts/screenshots.mjs",
        "check": "pnpm format:check && pnpm lint && pnpm lint:storage-ban && pnpm typecheck && pnpm test && pnpm build && pnpm audit"
    },
    "dependencies": {
        "openapi-fetch": "0.17.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "24.19.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "@vitest/coverage-v8": "5.0.3",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "jsdom": "30.1.2",
        "openapi-typescript": "7.13.0",
        "playwright": "1.63.0",
        "prettier": "3.9.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    }
}
