# Боевое окружение «Своих правил». Копия лежит в /etc/svoi-pravila/env (режим 600, владелец deploy).
# Формат KEY=VALUE без кавычек и без символа "$" в значениях (docker compose раскрывает "$").
# Каждое значение CHANGE_ME обязательно заменить; release.sh отказывается работать с CHANGE_ME.
# ВНИМАНИЕ: SP_DATA_KEK и SP_PSEUDONYM_PEPPER нельзя терять и нельзя менять после первого запуска.
# Потеря SP_DATA_KEK навсегда лишает доступа ко всем правилам и меткам (C2); храните копию вне сервера.
# Смена SP_PSEUDONYM_PEPPER обрывает связь псевдонимов в аналитике и лимитах; ротация только по RUNBOOK.

# Окружение приложения; в проде всегда production (включает строгие проверки настроек)
SP_ENVIRONMENT=production

# Уровень логов: INFO | WARNING | ERROR | CRITICAL (DEBUG в проде запрещён)
SP_LOG_LEVEL=INFO

# Публичное доменное имя сайта (без https:// и без пути); DNS A/AAAA запись должна указывать на VPS
SP_DOMAIN=CHANGE_ME

# Email для регистрации в Let's Encrypt (получает уведомления об истечении сертификата)
SP_ACME_EMAIL=CHANGE_ME

# Ключ шифрования данных C2: base64 ровно 32 байт. Генерация: openssl rand -base64 32
SP_DATA_KEK=CHANGE_ME

# Идентификатор версии ключа (строчные буквы, цифры и дефисы, 1-32 символа); при ротации увеличивайте
SP_DATA_KEK_ID=prod-1

# Перец для HMAC-псевдонимов: base64 не менее 32 байт. Генерация: openssl rand -base64 32
SP_PSEUDONYM_PEPPER=CHANGE_ME

# Ключ авторизации GigaChat из личного кабинета (секрет)
SP_GIGACHAT_CREDENTIALS=CHANGE_ME

# Область доступа GigaChat: PERS | B2B | CORP
SP_GIGACHAT_SCOPE=PERS

# Модель GigaChat для сценария «смягчить»
SP_GIGACHAT_MODEL_SOFTEN=GigaChat-3-Lightning

# Модель GigaChat для сценария «помоги сказать»
SP_GIGACHAT_MODEL_HELP_SAY=GigaChat-3-Lightning

# Модель GigaChat для сценария «расшифровать»
SP_GIGACHAT_MODEL_DECODE=GigaChat-2-Pro

# Модель GigaChat для подсказок правил
SP_GIGACHAT_MODEL_SUGGEST=GigaChat-3-Lightning

# Таймаут запроса к GigaChat в секундах (0-120)
SP_GIGACHAT_TIMEOUT_SECONDS=30

# Число повторов при временных ошибках GigaChat (0-2)
SP_GIGACHAT_MAX_RETRIES=1

# Токен бота от @BotFather (секрет)
SP_TELEGRAM_BOT_TOKEN=CHANGE_ME

# Секретная часть пути вебхука /tg/<секрет>: от 32 символов [A-Za-z0-9_-]. Генерация: openssl rand -hex 24
SP_TELEGRAM_WEBHOOK_PATH_SECRET=CHANGE_ME

# Секретный заголовок вебхука Telegram: 32-256 символов [A-Za-z0-9_-]. Генерация: openssl rand -hex 24
SP_TELEGRAM_WEBHOOK_SECRET_TOKEN=CHANGE_ME

# Глобальный дневной бюджет биллингуемых токенов LLM (целое число больше нуля; задаёт владелец)
SP_LLM_DAILY_TOKEN_BUDGET=CHANGE_ME

# Доля дневного бюджета за час, при которой пишется предупреждение о всплеске (0 < x <= 1)
SP_LLM_HOURLY_SPIKE_SHARE=0.25

# Дневная квота inline-подсказок на пользователя
SP_QUOTA_INLINE_PER_DAY=300

# Дневная квота «расшифровать» на пользователя
SP_QUOTA_DECODE_PER_DAY=40

# Лимит сообщений в личке на пользователя в минуту
SP_TELEGRAM_RATE_LIMIT_PER_MINUTE=30

# Лимит запросов мини-приложения на пользователя в минуту
SP_MINIAPP_REQUESTS_PER_MINUTE=120

# Часовой пояс отображения дат правил (IANA)
SP_DISPLAY_TIMEZONE=Europe/Moscow

# Часовой пояс календарных суток аналитики (IANA)
SP_ANALYTICS_TIMEZONE=Europe/Moscow

# Время ежедневного расчёта аналитики по SP_ANALYTICS_TIMEZONE (ЧЧ:ММ)
SP_ANALYTICS_RUN_AT=03:30

# Пользователь PostgreSQL (создаётся при первом запуске контейнера)
POSTGRES_USER=svoi

# Пароль PostgreSQL. Генерация: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Имя базы данных PostgreSQL
POSTGRES_DB=svoi_pravila

# Пароль Valkey. Генерация: openssl rand -hex 24
VALKEY_PASSWORD=CHANGE_ME

# Имя роли Grafana только для чтения аналитики
SP_GRAFANA_DB_USER=grafana_reader

# Пароль роли Grafana в PostgreSQL. Генерация: openssl rand -hex 24
SP_GRAFANA_DB_PASSWORD=CHANGE_ME

# Пароль администратора Grafana (вход через SSH-туннель). Генерация: openssl rand -hex 24
SP_GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Владелец (пользователь или организация GitHub) образов в ghcr.io, строчными буквами
SP_GHCR_OWNER=CHANGE_ME

# Логин GitHub для docker login в ghcr.io (токен лежит в /etc/svoi-pravila/ghcr-token, mode 600)
SP_GHCR_USER=CHANGE_ME

# Публичный ключ age (age1...) для шифрования бэкапов. Генерация: age-keygen -o backup.key; секретный ключ хранить вне сервера
SP_BACKUP_AGE_RECIPIENT=CHANGE_ME

# Тип S3-провайдера для rclone (например Other, Minio, Cloudflare, AWS)
SP_BACKUP_S3_PROVIDER=Other

# Конечная точка S3 (https://...) хранилища бэкапов
SP_BACKUP_S3_ENDPOINT=CHANGE_ME

# Регион S3 (для многих провайдеров достаточно us-east-1)
SP_BACKUP_S3_REGION=us-east-1

# Идентификатор ключа доступа S3 (только запись и список, без доступа к другим бакетам)
SP_BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME

# Секретный ключ доступа S3
SP_BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME

# Имя S3-бакета для бэкапов
SP_BACKUP_BUCKET=CHANGE_ME

# Префикс внутри бакета (без начального и конечного слэша)
SP_BACKUP_PREFIX=svoi-pravila
