# Application environment: local | test | staging | production (required)
SP_ENVIRONMENT=local

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (DEBUG forbidden in staging/production)
SP_LOG_LEVEL=INFO

# HTTP bind address and port for the ASGI server
SP_HTTP_HOST=127.0.0.1
SP_HTTP_PORT=8000

# Async SQLAlchemy URL (must use postgresql+asyncpg://)
SP_DATABASE_URL=postgresql+asyncpg://svoi:svoi_local_dev_only@127.0.0.1:5432/svoi_pravila

# Valkey URL (redis:// or rediss://)
SP_VALKEY_URL=redis://:svoi_local_dev_only@127.0.0.1:6379/0

# Per-probe readiness timeout in seconds (0 < x <= 5)
SP_READINESS_TIMEOUT_SECONDS=2.0

# Uvicorn --forwarded-allow-ips (comma-separated trusted proxy addresses)
SP_FORWARDED_ALLOW_IPS=127.0.0.1

# Field-encryption KEK: base64 of exactly 32 bytes. Leave empty locally —
# `make dev-env` / `make infra-up` fills a fresh key when missing. Never commit a real key.
SP_DATA_KEK=

# KEK version identifier (lowercase alphanumeric and hyphens, 1–32 chars)
SP_DATA_KEK_ID=local-1

# GigaChat authorization key (never commit a real key). Scope: PERS | B2B | CORP
SP_GIGACHAT_CREDENTIALS=
SP_GIGACHAT_SCOPE=PERS

# Path to НУЦ Минцифры CA bundle (host path relative to backend/ for local gates)
SP_GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.pem

# Per-scenario model names (benchmarked 2026-10-04; see backend/README.md)
SP_GIGACHAT_MODEL_SOFTEN=GigaChat-3-Lightning
SP_GIGACHAT_MODEL_HELP_SAY=GigaChat-3-Lightning
SP_GIGACHAT_MODEL_DECODE=GigaChat-2-Pro
SP_GIGACHAT_MODEL_SUGGEST=GigaChat-3-Lightning

# SDK request timeout (seconds) and transient-error retries (0–2)
SP_GIGACHAT_TIMEOUT_SECONDS=30
SP_GIGACHAT_MAX_RETRIES=1

# Telegram updates: polling | webhook | disabled
# local: polling or webhook; staging/production: webhook only; disabled: test only (CI stack-smoke)
SP_TELEGRAM_UPDATES_MODE=polling

# Bot token from BotFather (required unless mode=disabled). Never commit a real token.
# `make dev-env` never generates or overwrites this value.
SP_TELEGRAM_BOT_TOKEN=

# Webhook settings — required only when SP_TELEGRAM_UPDATES_MODE=webhook; must be unset otherwise
# SP_TELEGRAM_WEBHOOK_BASE_URL=https://example.example
# SP_TELEGRAM_WEBHOOK_PATH_SECRET=
# SP_TELEGRAM_WEBHOOK_SECRET_TOKEN=

# HMAC pepper for Valkey rate-limit pseudonyms: base64 of ≥32 bytes.
# Leave empty locally — `make dev-env` fills a fresh pepper when missing.
SP_PSEUDONYM_PEPPER=

# Max private-chat updates accepted per user per minute (default 30)
SP_TELEGRAM_RATE_LIMIT_PER_MINUTE=30

# Valkey TTL for Telegram update_id deduplication keys (default 300)
SP_TELEGRAM_DEDUP_TTL_SECONDS=300

# Seconds to wait for in-flight Telegram update tasks on shutdown (default 10)
SP_TELEGRAM_SHUTDOWN_GRACE_SECONDS=10

# Decode scenario deadline in seconds (default 45). API process only.
SP_DECODE_DEADLINE_SECONDS=45

# Minimum interval between sendMessageDraft updates in milliseconds (default 500)
SP_TELEGRAM_DRAFT_MIN_INTERVAL_MS=500

# Inline query minimum length before generation (default 8). API process only.
SP_INLINE_MIN_CHARS=8

# Per-user daily inline soften/help-say quota (product day in SP_ANALYTICS_TIMEZONE; default 300).
SP_QUOTA_INLINE_PER_DAY=300

# Per-user daily decode quota for DM and mini-app (product day; default 40).
SP_QUOTA_DECODE_PER_DAY=40

# Global daily billable-token budget for all LLM scenarios (required; no default). Owner sets locally.
# Dev example: 20000. CI materialize copies this from the example file.
SP_LLM_DAILY_TOKEN_BUDGET=20000

# Hourly spend share of the daily budget that triggers one llm_spend_spike log (default 0.25; (0, 1]).
SP_LLM_HOURLY_SPIKE_SHARE=0.25

# Inline generation deadline in seconds (default 8). API process only.
SP_INLINE_DEADLINE_SECONDS=8

# Pause after each inline keystroke before generation, milliseconds (default 600)
SP_INLINE_DEBOUNCE_MS=600

# Telegram cache_time for personal inline results, seconds (default 30)
SP_INLINE_CACHE_SECONDS=30

# Max in-process inline reuse entries across all users (default 10000). API process only.
SP_INLINE_REUSE_MAX_ENTRIES=10000

# Prepared-result ciphertext TTL in Valkey, seconds, at most 600 (default 600)
SP_PREPARED_RESULT_TTL_SECONDS=600

# Rule-source ciphertext TTL for «Сделать правилом», seconds, 60–600 (default 600)
SP_RULE_SOURCE_TTL_SECONDS=600


# IANA zone for user-facing rule dates (default Europe/Moscow)
SP_DISPLAY_TIMEZONE=Europe/Moscow

# Product analytics calendar timezone (default Europe/Moscow). Postgres uses this for day bounds.
SP_ANALYTICS_TIMEZONE=Europe/Moscow

# Local time for the in-process daily analytics job (default 03:30)
SP_ANALYTICS_RUN_AT=03:30

# Start the in-process analytics loop (default true)
SP_ANALYTICS_JOBS_ENABLED=true

# Optional https origin for the Telegram chat menu Web App button (no path/query)
# SP_MINIAPP_URL=https://example.trycloudflare.com

# Mini-app initData freshness window in seconds (default 3600; 60–86400)
SP_MINIAPP_INITDATA_MAX_AGE_SECONDS=3600

# Mini-app HTTP requests allowed per user per minute (default 120)
SP_MINIAPP_REQUESTS_PER_MINUTE=120

# Local compose — PostgreSQL
POSTGRES_USER=svoi
POSTGRES_PASSWORD=svoi_local_dev_only
POSTGRES_DB=svoi_pravila
POSTGRES_PORT=5432

# Local compose — Valkey
VALKEY_PASSWORD=svoi_local_dev_only
VALKEY_PORT=6379

# Grafana (Compose profile observability). Required for migrate (LOGIN role) and
# for the grafana service admin login. Passwords: no defaults — leave empty and
# let `make dev-env` / CI materializer fill random values, or set your own.
# Never commit real passwords.
SP_GRAFANA_DB_USER=grafana_reader
SP_GRAFANA_DB_PASSWORD=
SP_GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
