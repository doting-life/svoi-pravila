    {
      "id": 17,
      "type": "stat",
      "title": "Последний успешный бэкап: возраст, ч",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "datasource": {
        "type": "prometheus",
        "uid": "svoi-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 24
              },
              {
                "color": "red",
                "value": 26
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "svoi-metrics"
          },
          "expr": "(time() - sp_backup_last_success_timestamp_seconds{kind=\"daily\"}) / 3600",
          "instant": true
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Сработавшие алерты",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 65
      },
      "datasource": {
        "type": "prometheus",
        "uid": "svoi-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "С какого времени"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "С какого времени",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "alertstate": true,
              "job": true,
              "instance": true,
              "mountpoint": true,
              "device": true,
              "fstype": true,
              "kind": true,
              "data": true,
              "scenario": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "Value": 2
            },
            "renameByName": {
              "alertname": "Алерт",
              "severity": "Важность",
              "Value": "С какого времени"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "svoi-metrics"
          },
          "expr": "1000 * ALERTS_FOR_STATE and ignoring(alertstate) ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
